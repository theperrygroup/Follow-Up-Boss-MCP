FROM ghcr.io/astral-sh/uv:0.11.32@sha256:df4cae8f3a96d175e2e5f992e597550000edbe78fdc2594d5cd8de1a217f504c AS uv
FROM python:3.12-slim@sha256:09f7da3bc104798d0afb40bc08d23ab2da20a76130cec1f2ef170848f5d85217

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PROJECT_ENVIRONMENT=/opt/venv \
    PATH="/opt/venv/bin:${PATH}"

WORKDIR /app

# Match the immutable Debian source snapshot recorded by the pinned Python base image.
RUN sed -i \
        -e 's|http://deb.debian.org/debian-security|https://snapshot.debian.org/archive/debian-security/20260824T000000Z|' \
        -e 's|http://deb.debian.org/debian|https://snapshot.debian.org/archive/debian/20260824T000000Z|' \
        /etc/apt/sources.list.d/debian.sources \
    && apt-get -o Acquire::Check-Valid-Until=false update \
    && DEBIAN_FRONTEND=noninteractive apt-get install --yes --no-install-recommends \
        postgresql-client-17=17.11-0+deb13u1 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=uv /uv /uvx /bin/
COPY pyproject.toml uv.lock README.md /app/
COPY src /app/src
COPY docs/api-coverage-matrix.md /app/docs/api-coverage-matrix.md

RUN uv sync --frozen --no-dev --no-editable

COPY scripts/migrate_hosted_oauth_resource.py /app/scripts/migrate_hosted_oauth_resource.py
COPY deploy/postgres/migrations /app/deploy/postgres/migrations

RUN useradd --create-home --home-dir /home/appuser --shell /usr/sbin/nologin appuser

USER appuser

ENTRYPOINT ["python", "/app/scripts/migrate_hosted_oauth_resource.py"]
