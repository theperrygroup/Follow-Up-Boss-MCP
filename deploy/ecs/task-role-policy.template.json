{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadHostedConfigSecrets",
      "Effect": "Allow",
      "Action": [
        "secretsmanager:DescribeSecret",
        "secretsmanager:GetSecretValue"
      ],
      "Resource": [
        "__TENANT_DATABASE_URL_SECRET_ARN__",
        "__REDIS_URL_SECRET_ARN__",
        "__FUB_OAUTH_CLIENT_SECRET_ARN__",
        "__FUB_OAUTH_SYSTEM_KEY_SECRET_ARN__"
      ]
    },
    {
      "Sid": "ReadTenantCredentialSecrets",
      "Effect": "Allow",
      "Action": [
        "secretsmanager:DescribeSecret",
        "secretsmanager:GetSecretValue"
      ],
      "Resource": "__TENANT_SECRET_PREFIX_ARN__*"
    },
    {
      "Sid": "WriteOAuthTenantCredentialSecrets",
      "Effect": "Allow",
      "Action": [
        "secretsmanager:CreateSecret",
        "secretsmanager:DescribeSecret",
        "secretsmanager:PutSecretValue"
      ],
      "Resource": "__TENANT_SECRET_PREFIX_ARN__*"
    }
  ]
}
